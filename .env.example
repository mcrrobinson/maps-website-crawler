# Copy this file to .env and fill in your values.
# .env is gitignored — safe to put real secrets in it.

# Required: Google Cloud API key with "Places API (New)" and "Geocoding API" enabled.
GOOGLE_MAPS_API_KEY=

# Required only for site quality audits (site_audit_cli.py) — used for the
# Claude vision look-scoring. Get one from https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Starting location: set ADDRESS, or set both LAT and LNG. If ADDRESS is set it takes
# priority over LAT/LNG. Any of --address/--lat/--lng passed on the command line
# override these.
ADDRESS=
LAT=
LNG=
